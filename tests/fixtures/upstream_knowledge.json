          "description": "DEE internally swaps Ls/Rs with Lrs/Rrs for 7.1 sources. ffmpeg pre-processing compensates.",
          "filter": "pcm_to_ddp",
          "ffmpeg_workaround": "pan=7.1|c0=c0|c1=c1|c2=c2|c3=c3|c4=c6|c5=c7|c6=c4|c7=c5",
          "source": "deew/__main__.py:852, README.md:38",
          "notes": "Applies to pcm_ddp_v1 runtime preparation."
