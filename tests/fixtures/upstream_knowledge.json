          "result": "All streaming bitrates in the local schema succeed at runtime. For Atmos Blu-ray mode, DEE 5.2.1 rejects 768 and 1024 with 'DD+JOC: min data rate is 1152 for Blu-ray mode' and accepts 1152 through 1664.",
          "source": "2026-03-09 local runtime matrix"
        },
        {
          "title": "Atmos DDP71 Generated Mode Is Rejected By DEE",
          "filter": "encode_to_atmos_ddp",
          "sample": "testfiles/testADM.wav",
          "dee_version": "5.2.1",
          "variants": [
            "generated encode_mode=ddp71 + encoder_mode=ddp71"
          ],
          "result": "The generated ddp71 Atmos path does not execute successfully on DEE 5.2.1. DEE rejects the job during filter validation with 'Invalid encoder_mode value: ddp71'.",
          "source": "2026-03-09 local runtime matrix"
        },
        {
          "title": "Unknown Atmos Trim Fields Are Ignored For Streaming And Bluray",
          "filter": "encode_to_atmos_ddp",
          "sample": "testfiles/testADM.wav",
          "dee_version": "5.2.1",
          "variants": [
            "streaming generated XML: custom_trims.surround_trim_5_1=auto",
            "streaming generated XML: custom_trims.surround_trim_9_1=auto",
            "bluray generated XML: custom_trims.surround_trim_5_1=auto",
            "bluray generated XML: custom_trims.surround_trim_9_1=auto"
          ],
          "result": "Streaming and bluray generated XML both encode successfully and produce byte-identical EC3 outputs after replacing surround_trim_7_1 with surround_trim_9_1. This indicates unknown trim fields on the Atmos path are tolerated and ignored for these modes on this sample.",
          "source": "2026-03-09 local runtime matrix"
        }
      ]
